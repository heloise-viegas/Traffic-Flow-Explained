# ─────────────────────────────────────────────────────────
# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is in .gitignore — never commit real values.
# ─────────────────────────────────────────────────────────

aws_region   = "us-west-2"
project_name = "abc"
domain_name  = "abc.online"

# Networking (defaults are fine — change only if they clash
# with existing VPCs in your account)
vpc_cidr = "x.x.x.x/xx"

# key = Availability Zone, value = CIDR block
public_subnet_cidrs = {
  "us-west-2a" = "x.x.x.x/xx"
  "us-west-2b" = "x.x.x.x/xx"
}

private_subnet_cidrs = {
  "us-west-2a" = "x.x.x.x/xx"
}

# EC2
ec2_instance_type = "t3.micro"
key_pair_name     = "your-key-pair-name-here"   # ← CHANGE THIS
